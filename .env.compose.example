# Copy to .env.compose. Model settings and API key stay in .env.
COMPOSE_PROJECT_NAME=pedagoloop
POSTGRES_DB=pedago_loop
POSTGRES_USER=pedago
# Replace with your own strong password; keep it when reusing an existing volume.
POSTGRES_PASSWORD=replace-with-your-own-password
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8000
APP_IMAGE_TAG=local
