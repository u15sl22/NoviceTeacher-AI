# Professor demo: DeepSeek via the replaceable generic provider.
DATABASE_URL=sqlite:///./pedago_loop.db
# Local attachment default: <project>/storage/documents.
# Docker Compose overrides STORAGE_ROOT and database connection fields.
# STORAGE_ROOT=/absolute/path/to/documents
# DATABASE_URL=postgresql+psycopg://pedago:pedago@localhost:5432/pedago_loop
SUGGESTION_PROVIDER=generic_llm
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=45
LLM_EXTRA_BODY={"thinking":{"type":"disabled"},"max_tokens":2048}
LLM_PROVIDER=deepseek
# Selectable server-side profiles. The legacy LLM_* values above remain the
# DeepSeek credential/configuration for backward compatibility.
LLM_PROFILES=[{"id":"deepseek","label":"DeepSeek","provider":"deepseek","base_url":"https://api.deepseek.com","model":"deepseek-flash","extra_body":{"thinking":{"type":"disabled"},"max_tokens":2048}},{"id":"zhipu","label":"智谱 GLM","provider":"zhipu","base_url":"https://open.bigmodel.cn/api/paas/v4","model":"glm-4.7-flash","extra_body":{"max_tokens":2048}}]
DEFAULT_LLM_PROFILE=deepseek
ZHIPU_API_KEY=
# Keys for any additional profile IDs, e.g. {"my_model":"secret"}.
LLM_API_KEYS={}
AUTH_PROVIDER=development
DEVELOPMENT_USERNAME=development
CONTEXT_CONTRIBUTORS=["lesson_context","session_memory","knowledge_retrieval","case_retrieval"]
MAX_CONTEXT_TOKENS=12000
MEMORY_PROVIDER=rule_based
CASE_RETRIEVER=metadata
KNOWLEDGE_RETRIEVER=metadata
RETRIEVAL_TOP_K=3
SECTION_PARSER=bounded_v2
REVISION_STRATEGY=replace_or_append_v2
